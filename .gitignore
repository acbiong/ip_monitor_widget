# Python 编译缓存和测试缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 本地虚拟环境和编辑器文件
.venv/
venv/
env/
.idea/
.vscode/
*.swp
*.swo

# 临时构建目录、日志和操作系统文件
build/
*.egg-info/
*.log
*.tmp
.DS_Store
Thumbs.db

# PyInstaller/发布输出；发布文件保留在本机 dist/，通过构建脚本重新生成
dist/*

# 本地构建缓存不属于项目源代码
.cache/

# 本地敏感配置和冻结元数据仅存在于构建缓存或单文件内部
.env
.env.*
!.env.example
/src/BUILD_INFO.json
/BUILD_INFO.json
*.spec.bak
core
core.*
